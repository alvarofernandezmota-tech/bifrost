# Plantilla del .env de bifrost. Copiala a `.env` y rellena lo tuyo.
#
#     cp .env.example .env
#
# El .env NO se commitea (esta en .gitignore): lleva el token del bot.

# ---- obligatorias -------------------------------------------------------
#
# Sin estas dos el bot no arranca, o arranca y no deja pasar a nadie.

# El token que da @BotFather al crear el bot.
TELEGRAM_BOT_TOKEN=pega_aqui_tu_token_real

# Quien puede usarlo. El bot esta CERRADO por defecto: sin ids aqui no pasa
# nadie. Varios se separan por comas. Ojo: autoriza chats, no personas — en
# un grupo autorizado manda cualquiera del grupo.
TELEGRAM_CHAT_ID=tu_id_de_chat_autorizado

# ---- opcionales ---------------------------------------------------------
#
# Sin ellas el bot funciona igual; con ellas hace mas cosas. Cada una se
# puede poner y quitar sin tocar codigo.

# ENCIENDE QUE EL BOT ENTIENDA (ADR-020).
#
# Sin esta clave, un mensaje suelto va al diario tal cual, como siempre.
# Con ella, antes de escribir se le pregunta a `diario/entender.py` si en
# realidad es una tarea, un habito, una cita o un apunte:
#
#     «recuerdame llamar al medico el jueves»  -> tarea, con su fecha
#     «he hecho deporte»                       -> habito
#     «tele 3h»                                -> apunte
#     «hoy ha sido un dia raro»                -> diario, como siempre
#
# Solo actua cuando esta seguro. Ante la duda, al diario: esto no puede
# hacer que un mensaje se pierda.
#
# Es la variable que mas cambia el bot y la que mas facil es olvidar, porque
# sin ella no falla nada — simplemente no pasa nada.
ANTHROPIC_API_KEY=

# QUE MOTOR USA LO DE ARRIBA (ADR-022).
#
#     anthropic / claude   Claude en la nube, con la clave de arriba
#     ollama / local       un modelo en ESTA maquina. Nada sale de Madre
#     no / off / ninguno   apagado, aunque haya ANTHROPIC_API_KEY puesta
#
# Vacio = como si no existiera esta variable: anthropic si hay clave,
# apagado si no la hay. Nadie que ya lo tenia andando tiene que tocar nada.
MIDGAROR_LLM=

# La URL de Ollama, si no es la de siempre (http://127.0.0.1:11434). Vacio
# = esa por defecto. Solo hace falta tocarlo si Ollama corre en otra
# maquina o en otro puerto.
MIDGAROR_OLLAMA=

# El modelo que usa el motor elegido en MIDGAROR_LLM. Vacio = el que trae
# por defecto segun el motor (`diario/entender.py`: MODELO_POR_DEFECTO con
# Claude, MODELO_LOCAL_POR_DEFECTO con Ollama).
#
# Si usas Ollama, antes de activarlo hace falta bajarse el modelo en Madre:
#
#     ollama pull qwen2.5:7b
#
# Sin el modelo descargado, Ollama contesta con un error y el mensaje cae
# al diario igual que si no hubiera motor — no rompe nada, pero tampoco
# clasifica nada, y no hay ningun aviso salvo mirando `./estado.sh`.
MIDGAROR_LLM_MODELO=

# ---- lo que NO va aqui --------------------------------------------------
#
# MIDGAROR_DATOS (donde viven los datos del diario, ADR-016) la pone la
# unidad de systemd con `Environment=`, no este fichero: es de la maquina,
# no del bot. Ver midgaror/docs/procedimientos/mudanza-diario.md.
#
# Para las notas de voz no hace falta ninguna variable: basta con tener
# faster-whisper instalado (requirements.txt) y ffmpeg en el sistema.
